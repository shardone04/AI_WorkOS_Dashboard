PORT=3000

# Required for real Meeting Audio AI transcription.
# If empty, Meeting AI still runs with demo transcription.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional. Empty values fall back to built-in demo/default behavior.

# Google Identity Services OAuth client ID.
# Empty: Google Demo User login is used.
GOOGLE_CLIENT_ID=

# Admin login.
# Empty: ADMIN-2026 is used.
ADMIN_PASSCODE=

# Slack incoming webhook URL.
# Empty: team chat is saved locally and Slack send shows demo/fallback status.
SLACK_WEBHOOK_URL=

# Published Google Sheet CSV URL for shared expenses.
# Demo file template: sample-data/workos_shared_expenses.xlsx
# Published CSV should use columns: date, category, item, amount, owner, method
# Empty: built-in sample expense data is used.
GOOGLE_SHEETS_CSV_URL=

# Google Apps Script/Gmail webhook endpoint for daily summary mail.
# Empty: daily summary preview/copy remains available, real send is disabled.
GMAIL_WEBHOOK_URL=
