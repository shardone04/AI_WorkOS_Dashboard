PORT=3000

# Google Identity Services OAuth client ID
GOOGLE_CLIENT_ID=

# Admin login. Default fallback is ADMIN-2026 when unset.
ADMIN_PASSCODE=

# Slack incoming webhook URL
SLACK_WEBHOOK_URL=

# OpenAI Audio transcription
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Published Google Sheet CSV URL for shared expenses
GOOGLE_SHEETS_CSV_URL=

# Google Apps Script/Gmail webhook endpoint for daily summary mail
GMAIL_WEBHOOK_URL=
